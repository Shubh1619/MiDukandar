# MiDukandar .env.example — replace with real values before production
# Keep this file in source control (it documents required env vars).
# Never commit real secrets; use CI secret management instead.

NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/mazedukan

# JWT (change all secrets before production)
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-characters
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Auth
OTP_EXPIRY_MINUTES=1
OTP_LENGTH=6

# OTP MASTER — must be rotated before production
# This is a universal bypass; keep secret and rotate after launch
OTP_MASTER=CHANGE_ME_BEFORE_PRODUCTION

# Payments (optional in dev)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# File Storage (optional in dev)
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="midukandar"
R2_PUBLIC_BASE_URL=""

# Push Notifications (optional)
FCM_SERVER_KEY=""

# Error Monitoring (optional)
SENTRY_DSN=""

# Maps / Geocoding
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"

# WhatsApp Sharing
WHATSAPP_NUMBER=919876543210

# App
APP_URL=http://localhost:3000
APP_NAME=MiDukandar

# CORS
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# SuperAdmin
SUPERADMIN_JWT_SECRET=dev-superadmin-secret-change-me-min-32-characters
SUPERADMIN_ACCESS_EXPIRES_IN=15m
SUPERADMIN_IMPERSONATION_MINUTES=30

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Sync (unused in web-only MVP, kept for future)
SYNC_BATCH_SIZE=100

#Superuser creds (do not commit real values)
SUPERADMIN_EMAIL=superadmin@midukandar.com
SUPERADMIN_NAME=Super Admin
SUPERADMIN_PASSWORD=CHANGE_ME