# MiDukandar .env.example — replace with real values before production
# Keep this file in source control (it documents required env vars).
# Never commit real secrets; use CI secret management instead.

NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/mazedukan

# Safety guard: NODE_ENV=development refuses to start against a non-local
# DATABASE_URL unless this is "true".
# ALLOW_REMOTE_DB_IN_DEV=false

# JWT (change all secrets before production)
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-characters
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-characters
JWT_ACCESS_EXPIRES_IN=15m

# Email (Brevo REST API). MAIL_MODE=log prints emails (incl. OTP) to the
# console and never contacts Brevo — use it locally. Set MAIL_MODE=brevo and
# real credentials on Render/production.
# MAIL_FROM_EMAIL must be on a domain authenticated in Brevo (SPF+DKIM+DMARC);
# a free mailbox (@gmail.com, @yahoo.com, @outlook.com, @hotmail.com) is
# refused in production because it fails DMARC and lands in spam.
MAIL_MODE=log
# Production refuses to boot with MAIL_MODE=log (it would print login codes to
# the log and deliver nothing). Only set this for a throwaway prod-like env.
ALLOW_LOG_MAIL_IN_PRODUCTION=
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=MiDukandar
MAIL_REPLY_TO=
# Legacy aliases (deprecated): read only when MAIL_FROM_* above are unset.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MiDukandar
# Shared secret for the Brevo delivery webhook (POST /api/webhooks/brevo).
BREVO_WEBHOOK_SECRET=

# SMS – udhaari notification. `device` hands the message to the mobile app,
# which sends it from the phone's own SIM (free daily SMS) and reports back;
# no gateway credentials are needed. `log` prints messages to the server
# console and never calls a gateway (use it locally). msg91 / fast2sms require
# a DLT-approved sender and template; boot fails if they are selected without
# credentials.
SMS_MODE=device
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_TEMPLATE_ID=
SMS_DLT_ENTITY_ID=
SMS_DAILY_FREE_LIMIT=100
SMS_TIMEOUT_MS=5000

# Auth
OTP_EXPIRY_MINUTES=1
OTP_LENGTH=6

# OTP MASTER — DEV ONLY. A universal OTP bypass; refused in production.
OTP_MASTER=000000

# Payments (optional in dev)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# File Storage — local disk (backend/uploads). No credentials required.
# Optional absolute origin for stored-file URLs; defaults to APP_URL.
STORAGE_PUBLIC_BASE_URL=""

# Push Notifications (optional)
FCM_SERVER_KEY=""

# Error Monitoring (optional)
SENTRY_DSN=""

# App
APP_URL=http://localhost:3000
APP_NAME=MiDukandar

# CORS — comma-separated allowed browser origins. Non-production also allows
# any http://localhost:<port> origin automatically.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SuperAdmin
SUPERADMIN_JWT_SECRET=dev-superadmin-secret-change-me-min-32-characters
SUPERADMIN_ACCESS_EXPIRES_IN=15m
SUPERADMIN_IMPERSONATION_MINUTES=30

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
# Reverse-proxy hops whose X-Forwarded-For is believed. A hop only counts when
# it is a loopback address (the co-located Next.js proxy of the single-container
# image); every other hop forwards the caller's own header and is ignored, so
# rotating X-Forwarded-For cannot mint extra rate-limit buckets.
TRUST_PROXY_HOPS=1

# Superuser creds (do not commit real values)
SUPERADMIN_EMAIL=superadmin@midukandar.com
SUPERADMIN_NAME=Super Admin
SUPERADMIN_PASSWORD=CHANGE_ME
# The bootstrap is create-only: an existing superadmin keeps its stored
# password. Set this to true (or run the script with --rotate) only when you
# deliberately want to replace it with SUPERADMIN_PASSWORD.
SUPERADMIN_ROTATE_PASSWORD=