# MiDukandar web (Next.js) — local development template
# Copy to `web/.env.local`; Next.js loads it automatically.

# Browser-side API base URL. Leave EMPTY to use the same-origin Next.js proxy
# at /api/* (recommended: no CORS, cookies just work). Set an absolute URL only
# when the browser must call the API on a different origin.
NEXT_PUBLIC_API_URL=

# Server-side proxy target for /api/* (see src/proxy.ts). Local backend:
BACKEND_URL=http://localhost:4000

# Public origin of this web app. next.config.ts uses it to decide whether to
# send HSTS / upgrade-insecure-requests (https:// => yes).
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google AdSense
# ---------------------------------------------------------------------------
# The MiDukandar publisher and three ad units are built in as defaults, so the
# app serves ads with no extra configuration. Each placement can override its
# unit below; leave a value empty to use the built-in unit.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-5690703416607762
# Display banner unit: 2625894725 (top, reports, sidebar, footer, pricing)
# Free-feed unit:      9822517604 (dashboard, invoices, products, customers, expenses)
# In-article unit:     7004782570 (landing)
# Set NEXT_PUBLIC_ADSENSE_CLIENT to an empty string to disable AdSense and show
# the in-house "Sponsored" promos instead. NEXT_PUBLIC_* values are inlined at
# build time, so set them before `next build` / the Docker image build.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-5690703416607762
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_DASHBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_INVOICES=
NEXT_PUBLIC_ADSENSE_SLOT_PRODUCTS=
NEXT_PUBLIC_ADSENSE_SLOT_CUSTOMERS=
NEXT_PUBLIC_ADSENSE_SLOT_REPORTS=
NEXT_PUBLIC_ADSENSE_SLOT_EXPENSES=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE_ANCHOR=
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=
NEXT_PUBLIC_ADSENSE_SLOT_PRICING=
