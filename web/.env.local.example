# MiDukandar web (Next.js) — local development template
# Copy to `web/.env.local`; Next.js loads it automatically.

# Browser-side API base URL. Leave EMPTY to use the same-origin Next.js proxy
# at /api/* (recommended: no CORS, cookies just work). Set an absolute URL only
# when the browser must call the API on a different origin.
NEXT_PUBLIC_API_URL=

# Server-side proxy target for /api/* (see src/proxy.ts). Local backend:
BACKEND_URL=http://localhost:4000

# Public origin of this web app. next.config.ts uses it to decide whether to
# send HSTS / upgrade-insecure-requests (https:// => yes).
APP_URL=http://localhost:3000
