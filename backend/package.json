{
  "name": "midukandar-backend",
  "version": "1.0.0",
  "description": "MiDukandar - POS and business management backend (Fastify + raw SQL/Postgres)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:reset": "tsx scripts/reset-db.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:dev": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "superadmin:create": "tsx scripts/create-superadmin.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=unit",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@sentry/node": "^8.18.0",
    "bcryptjs": "^2.4.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "fastify": "^4.27.0",
    "fastify-plugin": "^4.5.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "qrcode": "^1.5.3",
    "razorpay": "^2.9.5",
    "tsx": "^4.15.0",
    "undici": "^8.10.2",
    "uuid": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.8",
    "eslint": "^9.5.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.2",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  }
}
