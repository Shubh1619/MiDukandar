# MiDukandar Backend — environment template
# Copy to backend/.env.local for local development (gitignored) or backend/.env,
# then fill in real values. Never commit real secrets.
#
# NODE_ENV != production  -> backend/.env.local then backend/.env are loaded
# NODE_ENV  = production  -> only backend/.env is loaded (host env vars win)

NODE_ENV=development
PORT=4000

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/mazedukan
# Optional non-pooler connection used for migrations (Neon, etc.)
DIRECT_URL=
# NODE_ENV=development refuses a non-local DATABASE_URL unless this is "true".
# ALLOW_REMOTE_DB_IN_DEV=false

# ── JWT / Sessions ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-characters
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=mz_refresh
# REFRESH_COOKIE_SECURE is derived from APP_URL when unset (Secure iff https).
# REFRESH_COOKIE_SECURE=true

# ── SuperAdmin ────────────────────────────────────────────────────────
SUPERADMIN_JWT_SECRET=dev-superadmin-secret-change-me-min-32-characters
SUPERADMIN_ACCESS_EXPIRES_IN=15m
SUPERADMIN_COOKIE_NAME=mz_sa
SUPERADMIN_IMPERSONATION_MINUTES=30
SUPERADMIN_EMAIL=superadmin@midukandar.com
SUPERADMIN_NAME=Super Admin
SUPERADMIN_PASSWORD=CHANGE_ME

# ── Auth / OTP ────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=1
OTP_LENGTH=6
# Universal OTP bypass — DEV ONLY; refused when NODE_ENV=production.
OTP_MASTER=000000

# ── Email (Brevo REST API) ────────────────────────────────────────────
# log   -> print emails (incl. OTP) to the console, never call Brevo
# brevo -> send via the Brevo HTTP API (requires the two values below)
MAIL_MODE=log
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MiDukandar

# ── Payments (Razorpay) — optional ────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── File storage — local disk (backend/uploads), no cloud creds ───────
# Optional absolute origin for stored-file URLs; defaults to APP_URL.
STORAGE_PUBLIC_BASE_URL=

# ── Push Notifications (FCM) / Error Monitoring (Sentry) — optional ───
FCM_SERVER_KEY=
SENTRY_DSN=

# ── App / CORS ────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
APP_NAME=MiDukandar
# Comma-separated allowed browser origins (non-prod also allows localhost:*).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Rate limiting / Proxy ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
# Reverse-proxy hops whose X-Forwarded-For is believed. A hop only counts when
# it is a loopback address (the co-located Next.js proxy in front of the API):
# the compose stack proxies from another container, so its forwarded header is
# ignored and the client IP comes from the TCP peer instead.
TRUST_PROXY_HOPS=1
