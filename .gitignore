# Dotenv and secrets — root level
.env*
!.env.example

# Backend local env (never tracked)
backend/.env
backend/.env.local

# === Node / Build artifacts (never track) ===
/node_modules/
node_modules/
/dist/
dist/
/build/
build/
/.next/
.next/
*.tsbuildinfo

# === Dart / Flutter artifacts ===
.dart_tool/
.flutter-plugins-dependencies
app/build/

# === Python ===
__pycache__/
*.pyc

# === IDE / runtime files ===
/.idea/
/.vscode/
# Keep the shared launch configs (local/render API URLs) but ignore the rest.
!/.vscode/launch.json
/*.local/

# === Lockfiles are committed on purpose (reproducible builds) ===

# === Next.js / Nuxt / build outputs ===
/nuxt/

# === Environment and secrets (override root .env above)
backend/.env
